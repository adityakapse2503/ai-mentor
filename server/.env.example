# Free LLM via Google Gemini (get a key at aistudio.google.com)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_key_here
LLM_MODEL=gemini-3.5-flash-lite

# Only needed if you use Claude (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional
PORT=8787
TOP_K=6
MIN_SCORE=0.25
CHUNK_SIZE=900
CHUNK_OVERLAP=150